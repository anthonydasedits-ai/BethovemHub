uC()
LP.CharacterAdded:Connect(function()task.wait(0.5)if cR then cR:Disconnect()cR=nil end al,wO,jO=nil,nil,nil uC()end)
local function pr()if cR then cR:Disconnect()cR=nil end if Hm and Hm.Parent then if wO then Hm.WalkSpeed=wO end if jO then Hm.JumpPower=jO end end al=nil end
local function tp(d,cb)if not Rt or not Hm or not Rt.Parent then return end if cR then cR:Disconnect()end if not wO then wO=Hm.WalkSpeed end if not jO then jO=Hm.JumpPower end Hm.WalkSpeed=700 Hm.JumpPower=260 al=d cR=R.Heartbeat:Connect(function(dt)if not Rt or not Rt.Parent or not Hm.Parent then pr()return end local o=Rt.Position local d=al-o d=Vector3.new(d.X,0,d.Z)local m=d.Magnitude if m<=4 then Rt.CFrame=CFrame.new(al)*(Rt.CFrame-Rt.Position)pr()if cb then cb()end return end local p=math.min(2e15*dt,m)local dv=d.Unit local np=o+dv*p np=Vector3.new(np.X,o.Y,np.Z)Rt.CFrame=CFrame.lookAt(np,np+dv)end)end
local prs=setmetatable({},{__mode="k"})local ex=false
local function cpr(p)if prs[p]then return end prs[p]=true p.Triggered:Connect(function()if not At or ex then return end if not Rt or not Rt.Parent then return end local sp=W:FindFirstChildOfClass("SpawnLocation")if not sp then return end ex=true local sv=Rt.Position tp(sp.Position,function()task.wait(0.3)if not At then ex=false return end tp(sv,function()ex=false end)end)end)end
local function vf(p)if p.Name~="SmartPromptPart"then return end for _,c in ipairs(p:GetChildren())do if c:IsA("ProximityPrompt")and c.Name=="CarryAreaEgg"then cpr(c)end end end
local function sc()for _,o in ipairs(W:GetDescendants())do if o.Name=="SmartPromptPart"then vf(o)end end end
W.DescendantAdded:Connect(function(o)if not At then return end if o.Name=="SmartPromptPart"then task.wait(0.05)vf(o)elseif o:IsA("ProximityPrompt")and o.Name=="CarryAreaEgg"then task.wait(0.05)local p=o.Parent while p and p~=W do if p.Name=="SmartPromptPart"then cpr(o)break end p=p.Parent end end end)
bT.OnChanged(function(s)At=s if s then sc()else pr()ex=false end end)
