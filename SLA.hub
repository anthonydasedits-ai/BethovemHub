local RC={["Light & Dark"]=1300,Titan=1100,Divine=1000,Transcendent=1000,Superior=1000,Eternal=900,Limited=900,Secret=800,Exotic=800,Cosmic=700,Exclusive=700,Admin=700,Mythic=600,Mythical=600,Prismatic=600,Rainbow=600,Legendary=500,Epic=400,Rare=300,SuperRare=200,Celestial=200,Uncommon=200,Basic=100,Common=100}
local CL={["Light & Dark"]=Color3.fromRGB(255,100,255),Titan=Color3.fromRGB(255,60,60),Divine=Color3.fromRGB(255,240,120),Transcendent=Color3.fromRGB(180,200,255),Superior=Color3.fromRGB(255,180,80),Eternal=Color3.fromRGB(120,220,255),Limited=Color3.fromRGB(255,150,200),Secret=Color3.fromRGB(255,60,60),Exotic=Color3.fromRGB(180,255,100),Cosmic=Color3.fromRGB(150,100,255),Exclusive=Color3.fromRGB(255,200,60),Admin=Color3.fromRGB(255,50,50),Mythic=Color3.fromRGB(255,100,100),Mythical=Color3.fromRGB(255,100,100),Prismatic=Color3.fromRGB(255,150,255),Rainbow=Color3.fromRGB(255,180,100),Legendary=Color3.fromRGB(255,200,80),Epic=Color3.fromRGB(180,100,255),Rare=Color3.fromRGB(100,180,255),Uncommon=Color3.fromRGB(100,255,150),Common=Color3.fromRGB(200,200,200)}
local IC,AC,NC={},{},{}
local function gA(c)if not c then return nil end if AC[c]~=nil then return AC[c]end local i=ASD and(ASD.Directory or ASD)[c]AC[c]=i or false return i or nil end
local function gR(r)if not r then return "Common"end local u=r.Uid or r.BoundsCFrame if u and NC[u]then return NC[u]end local n if r.Rarity then local x=r.Rarity n=type(x)=="table"and(x.DisplayName or x._id or x.Name)or tostring(x)else local c=r.AssetCategory or r.Category or r.Name local i=c and gA(c)if i and i.Rarity then local x=i.Rarity n=type(x)=="table"and(x.DisplayName or x._id or x.Name)or tostring(x)else local a=AD and(AD.Directory or AD)and(AD.Directory or AD)[r.AreaId]local ra=a and a.Rarity local rid=(type(ra)=="table"and(ra._id or ra.DisplayName or ra.Name))or(type(ra)=="string"and ra)or"Common"local ri=(RD and(RD.Rarities or RD)or{})[rid]or{}n=(type(ri)=="table"and(ri.DisplayName or ri._id))or(type(ra)=="table"and ra.DisplayName)or rid or"Common"end end n=n or"Common"if u then NC[u]=n end return n end
local function mM(r)local m=1 local mu=r.Mutations or r.Mutation if type(mu)=="table"then for _,x in pairs(mu)do if type(x)=="table"then m=m*(tonumber(x.Multiplier or x.Value or x.Scale)or 1.5)else local t=tostring(x):lower()if t:find("rainbow")then m=m*3 elseif t:find("gold")then m=m*2 elseif t:find("silver")then m=m*1.5 elseif t:find("parasite")or t:find("monstrous")then m=m*5 else m=m*1.25 end end end elseif mu then m=m*1.5 end if r.HasParasite then m=m*5 end return m end
local function gE(r)local c=tostring(r.AssetCategory or r.Category or r.Name or"Egg")local i=gA(c)local raw=tonumber(r.Income or r.EarningRate or r.MoneyPerSecond or r.MoneyPerSec or r.CashPerSecond or r.CPS or r.Money or r.Cash or r.Value or r.Price)if(not raw or raw<=0)and type(i)=="table"then raw=tonumber(i.Income or i.EarningRate or i.MoneyPerSecond or i.MoneyPerSec or i.CashPerSecond or i.CPS or i.Money or i.Cash or i.ProfileIncome or i.SalePrice or i.Price)end raw=tonumber(raw)or 0 local s=tonumber(r.AssetScale or r.Scale or r.NestScale)or 1 local v=raw*s*mM(r)if v<=0 then local rn=gR(r)local sc=RC[rn]or 100 local a=tonumber(tostring(r.AreaId or""):match("%d+"))or 50 v=sc*math.max(a,50)*math.max(s,1)end return v end
local function fV(v)v=tonumber(v)or 0 if v>=1e15 then return string.format("%.1fQ",v/1e15)elseif v>=1e12 then return string.format("%.1fT",v/1e12)elseif v>=1e9 then return string.format("%.1fB",v/1e9)elseif v>=1e6 then return string.format("%.1fM",v/1e6)elseif v>=1e3 then return string.format("%.1fK",v/1e3)else return string.format("%d",math.floor(v+0.5))end end
local function gI(r)if not r then return nil end local tn=r.Pet or r.PetId or r.PetName or r.AssetCategory or r.Category or r.Name if tn then local c=IC[tn]if c~=nil then return c~=false and c or nil end end local res local ri=r.Icon or r.PetIcon or r.ImageAsset or r.TextureId or r.Thumbnail or r.Image if ri then res=(type(ri)=="number"or not string.match(tostring(ri),"://"))and("rbxassetid://"..tostring(ri))or tostring(ri)end if not res and tn and PD then local p=(PD.Directory or PD)[tn]if p then local i=p.Icon or p.Image or p.AssetId or p.TextureId or p.Thumbnail if i then res=(type(i)=="number"or not string.match(tostring(i),"://"))and("rbxassetid://"..tostring(i))or tostring(i)end end end if not res and tn then local a=gA(tn)if a then local i=a.Icon or a.Image or a.AssetId or a.TextureId or a.Thumbnail if i then res=(type(i)=="number"or not string.match(tostring(i),"://"))and("rbxassetid://"..tostring(i))or tostring(i)end end end if tn then IC[tn]=res or false end return res end
