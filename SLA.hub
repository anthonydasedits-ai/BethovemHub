local function uE()if not ES or not ES.ReadFieldEggs then return end local ok,sn=pcall(ES.ReadFieldEggs)if not ok or not sn or not sn.Records then return end local h=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")if not h then return end local mp=h.Position local m2=MD*MD local cur={}
for _,r in ipairs(sn.Records)do if r.State=="Slot"and r.BoundsCFrame then local ep=r.BoundsCFrame.Position local dx,dy,dz=ep.X-mp.X,ep.Y-mp.Y,ep.Z-mp.Z local ds=dx*dx+dy*dy+dz*dz
if ds<=m2 then local u=r.Uid or tostring(r.BoundsCFrame)local rn=gR(r)if FR=="Todos"or rn:lower()==FR:lower()then cur[u]=true local e=aE[u]if not e then e=crE(u)aE[u]=e end e.part.CFrame=CFrame.new(ep)
local nm=tostring(r.AssetCategory or r.Category or r.Name or"Ovo")if e._n~=nm then e.name.Text=nm e._n=nm end if e._r~=rn then e.rar.Text=rn e._r=rn end
local cc=CL[rn]or Color3.fromRGB(220,220,220)if e._c~=cc then e.rar.TextColor3=cc e.stroke.Color=cc e._c=cc end
local i2=gI(r)if i2 then if e._i~=i2 then e.icon.Image=i2 e._i=i2 end e.icon.Visible=true else e.icon.Visible=false end
local vt="$"..fV(gE(r))if e._v~=vt then e.val.Text=vt e._v=vt end if e._m~=MD then e.billboard.MaxDistance=MD e._m=MD end end end end end
for u,e in pairs(aE)do if not cur[u]then e.part:Destroy()aE[u]=nil end end end
