local function fS()local u="https://games.roblox.com/v1/games/"..PID.."/servers/Public?sortOrder=Asc&limit=100"local ok,raw=ht(u)if not ok then return nil end local ok2,d=pcall(HS.JSONDecode,HS,raw)if not ok2 or not d or not d.data then return nil end local cid=tostring(game.JobId)local ls={}for _,s in ipairs(d.data)do if s.id and tostring(s.id)~=cid and s.playing<s.maxPlayers then table.insert(ls,{id=tostring(s.id),playing=s.playing or 0,maxPlayers=s.maxPlayers or 0})end end table.sort(ls,function(a,b)return a.playing<b.playing end)return ls end
